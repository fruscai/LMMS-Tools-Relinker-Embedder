{
  "name": "lmms-path-relinker",
  "version": "1.0.0",
  "description": "Bulk-repair broken external audio-file paths inside LMMS .mmp and .mmpz project files.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "yauzl": "^3.1.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.lmmstools.pathrelinker",
    "productName": "LMMS Path Relinker",
    "files": ["src/**/*", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.music" },
    "win": { "target": ["nsis", "portable"] }
  }
}
